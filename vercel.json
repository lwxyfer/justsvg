{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_DISABLE_OFFLINE=1 npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/editor", "destination": "/index.html" },
    { "source": "/examples", "destination": "/index.html" }
  ]
}
