    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
